{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "src/infrastructure/database/generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["NEXT_PUBLIC_API_URL"]
    },
    "@whatsapp/api#dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["HOST", "PORT", "DATABASE_URL", "CORS_ORIGINS"]
    }
  }
}
