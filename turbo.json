{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "src/infrastructure/database/generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_INTERNAL_URL"]
    },
    "@whatsapp/api#dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "HOST",
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "AUTH_ACCESS_SECRET",
        "AUTH_REFRESH_SECRET",
        "AUTH_CSRF_SECRET",
        "AUTH_ISSUER",
        "AUTH_AUDIENCE",
        "AUTH_ACCESS_TTL_SECONDS",
        "AUTH_REFRESH_TTL_SECONDS",
        "AUTH_SESSION_TTL_SECONDS",
        "AUTH_CSRF_TTL_SECONDS",
        "BCRYPT_ROUNDS"
      ]
    }
  }
}
