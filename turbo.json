{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "src/database/generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_INTERNAL_URL"]
    },
    "@whatsapp/api#dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "SWAGGER_ENABLED",
        "HOST",
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "AUTH_ACCESS_SECRET",
        "AUTH_REFRESH_SECRET",
        "AUTH_CSRF_SECRET",
        "AUTH_ISSUER",
        "AUTH_AUDIENCE",
        "AUTH_ACCESS_TTL_SECONDS",
        "AUTH_REFRESH_TTL_SECONDS",
        "AUTH_SESSION_TTL_SECONDS",
        "AUTH_CSRF_TTL_SECONDS",
        "BCRYPT_ROUNDS",
        "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
        "WHATSAPP_APP_SECRET",
        "WHATSAPP_APP_ID",
        "WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID",
        "WHATSAPP_LOGIN_CONFIG_ID",
        "WHATSAPP_OAUTH_REDIRECT_URI",
        "WHATSAPP_GRAPH_API_VERSION",
        "WHATSAPP_CREDENTIALS_KEY"
      ]
    }
  }
}
