# Private server-to-server base URL; includes the API prefix.
# Browser requests always use the same web origin at /api/v1.
# This config also defines the rewrite destination: rebuild after changing it.
API_INTERNAL_URL=http://localhost:8000/api/v1
# API CORS_ORIGINS must include the exact PUBLIC web origin (e.g. http://localhost:3000).
# Production: public HTTPS and API NODE_ENV=production for __Host-* Secure cookies.
