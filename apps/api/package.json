{
  "name": "@whatsapp/api",
  "version": "0.0.1",
  "private": true,
  "description": "Modular NestJS foundation for WhatsApp AI Sales SaaS",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "deploy": "nest deploy",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "start:debug": "node scripts/dev.mjs --inspect",
    "start:prod": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "auth:configure": "node scripts/configure-auth.mjs",
    "db:docker": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.8",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.9",
    "@nestjs/mau": "^0.2.8",
    "@nestjs/schematics": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@whatsapp/typescript-config": "workspace:*",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
