model Product {
  isDeleted         Boolean     @default(false)
  id                String      @id @default(uuid()) @db.Uuid
  businessId        String      @db.Uuid
  name              String
  sku               String
  description       String      @default("") @db.Text
  category          String      @default("")
  brand             String      @default("")
  supplier          String      @default("")
  barcode           String      @default("")
  price             Decimal     @db.Decimal(18, 2)
  cost              Decimal     @default(0) @db.Decimal(18, 2)
  compareAtPrice    Decimal?    @db.Decimal(18, 2)
  currency          String      @default("PEN") @db.Char(3)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(0)
  weightGrams       Int         @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]

  @@unique([businessId, id])
  @@unique([businessId, sku])
  @@index([businessId, active])
  @@map("Products")
}
