enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  isDeleted      Boolean          @default(false)
  id             String           @id @default(uuid()) @db.Uuid
  businessId     String           @db.Uuid
  conversationId String           @db.Uuid
  direction      MessageDirection
  status         MessageStatus    @default(PENDING)
  body           String           @db.Text
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation   Conversation     @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, conversationId, createdAt])
  @@map("Messages")
}
