enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  businessId String      @db.Uuid
  reference  String
  clientId   String      @db.Uuid
  storeId    String      @db.Uuid
  status     OrderStatus @default(PENDING)
  currency   String      @default("PEN") @db.Char(3)
  placedAt   DateTime    @default(now()) @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  client     Client      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  store      Store       @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  items      OrderItem[]

  @@unique([businessId, id])
  @@unique([businessId, reference])
  @@index([businessId, placedAt])
  @@index([businessId, status])
  @@index([businessId, clientId])
  @@index([businessId, storeId])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  orderId     String   @db.Uuid
  productId   String   @db.Uuid
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 2)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order       Order    @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Restrict)
  product     Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, orderId])
  @@index([businessId, productId])
}
