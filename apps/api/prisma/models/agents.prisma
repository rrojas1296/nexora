enum AgentTone {
  FRIENDLY
  PROFESSIONAL
  CONCISE
}

model Agent {
  isDeleted    Boolean   @default(false)
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @db.Uuid
  storeId      String?   @db.Uuid
  name         String
  tone         AgentTone @default(FRIENDLY)
  instructions String    @db.Text
  greeting     String    @default("") @db.Text
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store        Store?    @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, storeId])
  @@map("Agents")
}
