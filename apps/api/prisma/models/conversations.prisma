enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ConversationAssignment {
  AGENT
  HUMAN
}

model Conversation {
  id             String                 @id @default(uuid()) @db.Uuid
  businessId     String                 @db.Uuid
  clientId       String                 @db.Uuid
  storeId        String?                @db.Uuid
  assigneeUserId String?                @db.Uuid
  status         ConversationStatus     @default(OPEN)
  assignment     ConversationAssignment @default(AGENT)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  client         Client                 @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  store          Store?                 @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  assignee       Membership?            @relation(fields: [businessId, assigneeUserId], references: [businessId, userId], onDelete: Restrict)
  messages       Message[]

  @@unique([businessId, id])
  @@index([businessId, status, updatedAt])
  @@index([businessId, clientId])
  @@index([businessId, storeId])
  @@index([businessId, assigneeUserId])
}
