enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

model User {
  isDeleted    Boolean       @default(false)
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  name         String
  passwordHash String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  memberships  Membership[]
  authSessions AuthSession[]

  @@map("Users")
}

model Membership {
  isDeleted             Boolean          @default(false)
  businessId            String           @db.Uuid
  userId                String           @db.Uuid
  role                  MembershipRole   @default(VIEWER)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  authSessions          AuthSession[]
  refreshSessions       RefreshSession[]
  assignedConversations Conversation[]

  @@id([businessId, userId])
  @@index([userId])
  @@map("Memberships")
}

model AuthSession {
  isDeleted     Boolean          @default(false)
  id            String           @id @default(uuid()) @db.Uuid
  businessId    String?          @db.Uuid
  userId        String           @db.Uuid
  expiresAt     DateTime         @db.Timestamptz(3)
  idleExpiresAt DateTime         @db.Timestamptz(3)
  revokedAt     DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  membership    Membership?      @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshSession[]

  @@unique([businessId, userId, id])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("AuthSessions")
}

model RefreshSession {
  isDeleted        Boolean     @default(false)
  id               String      @id @default(uuid()) @db.Uuid
  businessId       String?     @db.Uuid
  userId           String      @db.Uuid
  familyId         String      @db.Uuid
  refreshTokenHash String      @unique
  expiresAt        DateTime    @db.Timestamptz(3)
  revokedAt        DateTime?   @db.Timestamptz(3)
  consumedAt       DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  membership       Membership? @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)
  family           AuthSession @relation(fields: [familyId], references: [id], onDelete: Restrict)

  @@index([businessId, userId])
  @@index([businessId, familyId])
  @@index([expiresAt])
  @@map("RefreshSessions")
}
