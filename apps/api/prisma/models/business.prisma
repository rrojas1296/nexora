model Business {
  isDeleted               Boolean                        @default(false)
  id                      String                         @id @default(uuid()) @db.Uuid
  slug                    String                         @unique
  name                    String
  description             String                         @default("")
  currency                String                         @default("PEN")
  timezone                String                         @default("UTC")
  contextDraft            String                         @default("")
  contextPublished        String                         @default("")
  contextVersion          Int                            @default(0)
  revision                Int                            @default(0)
  contextPublishedAt      DateTime?                      @db.Timestamptz(3)
  createdAt               DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @db.Timestamptz(3)
  memberships             Membership[]
  stores                  Store[]
  products                Product[]
  productCategories       ProductCategory[]
  productImages           ProductImage[]
  clients                 Client[]
  orders                  Order[]
  orderItems              OrderItem[]
  conversations           Conversation[]
  messages                Message[]
  agents                  Agent[]
  whatsappAuthorizations  WhatsappAuthorizationAttempt[]
  whatsappConnection      WhatsappConnection?
  whatsappSendAttempts    WhatsappSendAttempt[]
  whatsappAiReplyJobs     WhatsappAiReplyJob[]
  whatsappThreads         WhatsappThread[]
  whatsappInboundMessages WhatsappInboundMessage[]

  @@map("Businesses")
}
