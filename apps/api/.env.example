# Local development only. Copy to .env inside apps/api. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000

# PostgreSQL is external; no database is provisioned or migrated automatically.
DATABASE_URL=postgresql://conversa:change-me@localhost:5432/conversa?schema=public

# Comma-separated exact origins, without trailing slash, path, query or wildcard.
# Production origins must use HTTPS; CORS does not replace authentication or CSRF.
CORS_ORIGINS=http://localhost:3000
