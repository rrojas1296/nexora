# Local development only. Copy to .env inside apps/api. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000

# PostgreSQL is external; no database is provisioned or migrated automatically.
DATABASE_URL=postgresql://conversa:change-me@localhost:5432/conversa?schema=public

# Comma-separated exact origins, without trailing slash, path, query or wildcard.
# Production origins must use HTTPS; CORS does not replace authentication or CSRF.
CORS_ORIGINS=http://localhost:3000

# Run `pnpm --filter @whatsapp/api auth:configure` after copying this example.
# Generates three independent random secrets locally, preserving configured values.
# Supply real secrets via the secret manager in production, never NEXT_PUBLIC_.
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_CSRF_SECRET=
AUTH_ISSUER=nexora-api
AUTH_AUDIENCE=nexora-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_CSRF_TTL_SECONDS=3600
BCRYPT_ROUNDS=12
