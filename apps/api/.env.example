# Local development only. Copy to .env inside apps/api. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000

# Swagger: enabled outside production by default. Public docs, not public API access.
# Uncomment to override. Restrict access at the proxy if enabling in production.
# SWAGGER_ENABLED=true
# For Try it out directly on port 8000, explicitly allow its origin in CORS_ORIGINS too.

# Local PostgreSQL: run `docker compose up -d db` from the repository root.
# Credentials match compose.yaml; migrations must be applied explicitly.
DATABASE_URL=postgresql://conversa:change-me@localhost:5432/conversa?schema=public

# Comma-separated exact origins, without trailing slash, path, query or wildcard.
# Production origins must use HTTPS; CORS does not replace authentication or CSRF.
CORS_ORIGINS=http://localhost:3000

# Run `pnpm --filter @whatsapp/api auth:configure` after copying this example.
# Generates three independent random secrets locally, preserving configured values.
# Supply real secrets via the secret manager in production, never NEXT_PUBLIC_.
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_CSRF_SECRET=
AUTH_ISSUER=nexora-api
AUTH_AUDIENCE=nexora-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_CSRF_TTL_SECONDS=3600
BCRYPT_ROUNDS=12

# WhatsApp / Meta — configuración privada del backend, nunca NEXT_PUBLIC_.
# Estas funciones son opcionales. Para activarlas, sustituir los ejemplos y
# descomentar las variables correspondientes. No usar valores vacíos: los campos
# opcionales deben omitirse si todavía no se configuran (validación Zod).
# Guía de configuración y requisitos externos: docs/whatsapp.md.

# Versión de Graph API compatible con la app de Meta.
WHATSAPP_GRAPH_API_VERSION=v25.0

# Webhook: crear un valor aleatorio y copiar EL MISMO en el campo Verify token
# al configurar la URL del webhook en Meta. No es un token de acceso de Graph.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO

# Meta App Dashboard → Configuración de la app → Básica → Clave secreta de la app.
# Sirve para verificar firmas del webhook y canjear códigos OAuth en el backend.
# No confundir con el access token temporal de la consola de WhatsApp.
# WHATSAPP_APP_SECRET=REEMPLAZAR_CON_APP_SECRET_DE_META

# Clave propia para cifrar los tokens de cada negocio en PostgreSQL.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Debe representar exactamente 32 bytes en Base64. No reutilizar AUTH_*.
# Conservar estable y respaldar: cambiarla impide descifrar conexiones existentes.
# WHATSAPP_CREDENTIALS_KEY=REEMPLAZAR_CON_CLAVE_BASE64_GENERADA

# Facebook Login for Business — conexión por redirección de números Cloud API existentes.
# Requiere APP_SECRET, CREDENTIALS_KEY y GRAPH_API_VERSION anteriores,
# además de configurar el webhook y los permisos/dominios en Meta.
# Meta App Dashboard → Configuración de la app → Básica → Identificador de la app.
# Solo dígitos; descomentar únicamente después de introducir el ID real.
# WHATSAPP_APP_ID=REEMPLAZAR_CON_APP_ID_DE_META

# Facebook Login for Business → Configuraciones → autorización de activos existentes.
# Usar token de integración de negocio/sistema, WhatsApp Business Accounts como
# activos y permisos whatsapp_business_management / whatsapp_business_messaging.
# NO usar una configuración cuyo recorrido obligue a Embedded Signup/SDK.
# Copiar el ID de configuración, NO el WABA ID ni el Phone Number ID. Solo dígitos.
# WHATSAPP_LOGIN_CONFIG_ID=REEMPLAZAR_CON_CONFIG_ID_DE_META

# Callback HTTPS público EXACTO, en el mismo origen que el frontend (cookies).
# Añadir el mismo origen a CORS_ORIGINS y esta URI a Valid OAuth Redirect URIs
# de Meta. Publicar también el frontend, no solo la API. Sin query ni fragmento.
# WHATSAPP_OAUTH_REDIRECT_URI=https://tu-dominio.example/api/v1/whatsapp/oauth/callback

# Compatibilidad API anterior: Embedded Signup estándar con SDK, sin UI actual.
# No se necesita para el flujo por redirección.
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=REEMPLAZAR_CON_CONFIG_ID_EMBEDDED_SIGNUP

# No configurar un access token global: OAuth lo obtiene en el backend
# por negocio; la conexión manual lo recibe mediante la API autenticada.
# Sin estos valores WhatsApp queda deshabilitado; el registro Nexora sigue disponible.
